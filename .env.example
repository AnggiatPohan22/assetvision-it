APP_ENV=development
POSTGRES_DB=assetvision
POSTGRES_USER=assetvision
POSTGRES_PASSWORD=
JWT_SECRET=
ACCESS_TOKEN_EXPIRE_MINUTES=15
COOKIE_SECURE=false
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
LOG_LEVEL=INFO
IMAGE_STORAGE_ROOT=/var/lib/assetvision/uploads
IMAGE_MAX_BYTES=8388608
IMAGE_MAX_DIMENSION=8192
IMAGE_MAX_PIXELS=16000000
IMAGE_MAX_PER_MODEL=20

# Optional recognition API CPU profile only; blank keeps the production NO_GO/manual fallback.
RECOGNITION_ENCODER_NAME=
RECOGNITION_WEIGHTS_ROOT=/opt/weights/hub/checkpoints
OCR_MODELS_ROOT=
# Build-only CPU image (choose explicitly after building its existing opt-in environment).
RECOGNITION_CPU_BASE=assetvision-recognition-index:3-02
